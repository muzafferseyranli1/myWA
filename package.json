{
  "name": "mywa",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp-integrated Task Management & Kanban Platform",
  "scripts": {
    "dev": "node --env-file=.env --import tsx server/index.ts",
    "build": "next build",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "node --env-file=.env scripts/migrate-safe.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "waha:check": "node --env-file=.env scripts/check-waha-session.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^5.22.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.47.0",
    "multer": "^1.4.5-lts.1",
    "next": "15.5.25",
    "pino": "^9.5.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25"
  }
}
