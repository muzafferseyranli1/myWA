# Environment
NODE_ENV=production
PORT=3060

# Database (separate PostgreSQL container)
DATABASE_URL=postgresql://mywa:MyWA_Secure_2026!@mywa-db:5432/mywa

# JWT Authentication
JWT_SECRET=mywa_jwt_secret_change_in_production_2026

# Admin credentials (initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# WhatsApp
WA_SESSION_PATH=./.baileys_auth

# File uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=50
