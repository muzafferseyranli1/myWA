# Environment
NODE_ENV=production
PORT=3060

# Database
DATABASE_URL=postgresql://mywa:CHANGE_ME@mywa-db:5432/mywa
POSTGRES_DB=mywa
POSTGRES_USER=mywa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_PORT=5433

# JWT Authentication (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_RANDOM_SECRET

# Admin credentials (initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# WAHA (WhatsApp HTTP API Microservice)
# Generate two different values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both services receive WAHA_API_KEY; WAHA signs webhooks with WAHA_WEBHOOK_SECRET.
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
# Manifest content hash verified against Docker Hub on 2026-09-18. Validate runtime in staging before rollout.
WAHA_IMAGE=devlikeapro/waha@sha256:527ff3d634925adb26d596883d7b3ca502c080f737af3c2af2be0c973c511533
# Leave empty for Compose's internal webhook address (uses PORT); APP_URL is for browser task links.
WAHA_WEBHOOK_URL=
WAHA_API_URL=http://localhost:3000
WAHA_SESSION_NAME=default
WAHA_PORT=3000
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=MyWA_123

# File uploads
UPLOAD_QUOTA_MB=5120
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=50

# App public URL (used in WhatsApp task links, e.g. https://yourdomain.com)
APP_URL=http://localhost:3060

# CORS: comma-separated allowed origins, or * for all (not recommended in production)
ALLOWED_ORIGIN=http://localhost:3060

# Private incoming-media archive (persist this directory/volume)
MEDIA_DIR=./data/media
MEDIA_MAX_MB=100
MEDIA_QUOTA_MB=10240
