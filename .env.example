# Environment
NODE_ENV=production
PORT=3060

# Database
DATABASE_URL=postgresql://mywa:CHANGE_ME@mywa-db:5432/mywa
POSTGRES_DB=mywa
POSTGRES_USER=mywa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_PORT=5433

# JWT Authentication (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_RANDOM_SECRET

# Admin credentials (initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# WhatsApp
WA_SESSION_PATH=./.baileys_auth

# File uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=50

# App public URL (used in WhatsApp task links, e.g. https://yourdomain.com)
APP_URL=http://localhost:3060

# CORS: comma-separated allowed origins, or * for all (not recommended in production)
ALLOWED_ORIGIN=http://localhost:3060
