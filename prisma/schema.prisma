generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  SYSTEM
}

enum UserRole {
  ADMIN
  USER
}

// ─── Auth User (Panel Login) ──────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdTasks Task[]   @relation("taskCreatorUser")

  @@map("users")
}

// ─── WhatsApp Data Models ─────────────────────────────

model Chat {
  id        String    @id // WhatsApp JID (e.g. 905xxx@s.whatsapp.net or 120xxx@g.us)
  name      String
  isGroup   Boolean   @default(false) @map("is_group")
  avatarUrl String?   @map("avatar_url")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  messages     Message[]
  tasks        Task[]
  participants GroupParticipant[]

  @@map("chats")
}

model Contact {
  id          String   @id // WhatsApp JID or LID
  lidId       String?  @unique @map("lid_id") // LID format ID for mapping
  phoneNumber String   @map("phone_number")
  pushName    String?  @map("push_name")
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")

  sentMessages        Message[]          @relation("sender")
  taskAssignments     TaskAssignee[]
  groupParticipations GroupParticipant[]

  @@map("contacts")
}

model GroupParticipant {
  id        String @id @default(uuid())
  chatId    String @map("chat_id")
  contactId String @map("contact_id")
  role      String @default("member") // "admin", "superadmin", "member"

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([chatId, contactId])
  @@map("group_participants")
}

model Message {
  id           String      @id // WhatsApp Message ID
  chatId       String      @map("chat_id")
  senderId     String?     @map("sender_id")
  body         String?
  quotedText   String?     @map("quoted_text")
  quotedSender String?     @map("quoted_sender")
  messageType  MessageType @default(TEXT) @map("message_type")
  mediaUrl     String?     @map("media_url")
  mediaName    String?     @map("media_name")
  mediaMime    String?     @map("media_mime")
  isFromMe     Boolean     @default(false) @map("is_from_me")
  timestamp    DateTime
  preview      Json?
  ack          Int?
  revoked      Boolean     @default(false)
  editedAt     DateTime?   @map("edited_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  Contact? @relation("sender", fields: [senderId], references: [id], onDelete: SetNull)
  task    Task?    @relation("sourceMessage")
  reads   MessageRead[]

  @@index([chatId, timestamp])
  @@map("messages")
}

model Task {
  id              String       @id @default(uuid())
  requestKey      String?      @unique @map("request_key")
  chatId          String       @map("chat_id")
  sourceMessageId String?      @unique @map("source_message_id")
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?    @map("due_date")
  createdBy       String?      @map("created_by")
  notifyOnCreate  Boolean      @default(true) @map("notify_on_create")
  completionNote  String?      @map("completion_note")
  completedAt     DateTime?    @map("completed_at")
  completedBy     String?      @map("completed_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  chat          Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message?      @relation("sourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  creator       User?         @relation("taskCreatorUser", fields: [createdBy], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]
  reminders     TaskReminder[]

  @@index([chatId, status])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model MessageRead {
  userId    String   @map("user_id")
  messageId String   @map("message_id")
  readAt    DateTime @default(now()) @map("read_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@id([userId, messageId])
  @@map("message_reads")
}

model MessageReaction {
  messageId String @map("message_id")
  senderId  String @map("sender_id")
  text      String
  timestamp DateTime
  @@id([messageId, senderId])
  @@map("message_reactions")
}

model SyncState {
  session         String   @id
  completedUntil  Int      @default(0) @map("completed_until")
  roundUntil      Int?     @map("round_until")
  offset          Int      @default(0)
  lastSuccessAt   DateTime? @map("last_success_at")
  lastError       String?  @map("last_error")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@map("sync_states")
}

enum InboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  UNKNOWN
  CANCELLED
}

model IncomingEvent {
  id            String      @id @default(uuid())
  eventKey      String      @unique @map("event_key")
  payload       Json
  status        InboxStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?   @map("locked_until")
  lockToken     String?     @map("lock_token")
  lastError     String?     @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  @@index([status, nextAttemptAt])
  @@map("incoming_events")
}

model OutgoingJob {
  id            String         @id @default(uuid())
  sequence      BigInt         @unique @default(autoincrement())
  operationKey  String         @unique @map("operation_key")
  chatId        String         @map("chat_id")
  taskId        String?        @map("task_id")
  kind          String
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?      @map("locked_until")
  lockToken     String?        @map("lock_token")
  providerId    String?        @map("provider_id")
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  @@index([status, nextAttemptAt])
  @@index([chatId, sequence])
  @@index([taskId])
  @@map("outgoing_jobs")
}

model SchedulerRun {
  day       String   @id
  createdAt DateTime @default(now()) @map("created_at")
  @@map("scheduler_runs")
}

model ConnectionPreference {
  session       String   @id
  enabled       Boolean  @default(true)
  lastDispatchAt DateTime? @map("last_dispatch_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("connection_preferences")
}

model TaskAssignee {
  id        String @id @default(uuid())
  taskId    String @map("task_id")
  contactId String @map("contact_id")

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([taskId, contactId])
  @@map("task_assignees")
}

model TaskReminder {
  id             String   @id @default(uuid())
  taskId         String   @map("task_id")
  sentAt         DateTime @default(now()) @map("sent_at")
  messageContent String   @map("message_content")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_reminders")
}
